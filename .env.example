# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# 공공데이터포털(data.go.kr) 일반 인증키 (Decoding 키 권장, Encoding 키도 동작)
# 보통 계정당 키가 하나라 MOLIT_SERVICE_KEY 하나만 채우면 됩니다.
MOLIT_SERVICE_KEY=

# API별로 키가 다르면 아래를 채웁니다 (비워두면 MOLIT_SERVICE_KEY 사용)
MOLIT_TRADE_KEY=
MOLIT_RENT_KEY=

# 네이버 MYBOX 개인 액세스 토큰 (있으면 클라우드 분담 모드). 발급·갱신은 '토큰·키 갱신 안내서.md'
MYBOX_TOKEN=
# 토큰 만료일 (예: 2027-04-30). 적어 두면 '점검 실행.bat' 이 14일 전부터 알려 준다
MYBOX_TOKEN_EXPIRES=
